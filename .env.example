# Trading Agent - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# IMPORTANT: .env should NEVER be committed to version control

# API Keys
POLYGON_API_KEY=your_polygon_api_key_here
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Email Configuration (Gmail with App Password)
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@gmail.com
EMAIL_PASS=your_16_char_app_password

# Trading Settings
SYMBOLS=SPY,QQQ,IWM,DIA,TLT
POLL_INTERVAL=300
BACKTEST_MODE=False
BACKTEST_DAYS=30

# Flask Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Test Mode (bypasses market hours check, runs immediately for testing)
# Set to False in production to respect market hours
TEST_MODE=False
